<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Flash bolt, centered in the 66dp adaptive-icon safe zone.
      Source master: logo-claude/svg/flash-adaptive-foreground.svg
      The bolt is authored in a 24x24 box: path centered on (12,12).
      Group transform: translate to icon center (54,54), scale up, re-center the box.
    -->
    <group
        android:name="bolt"
        android:translateX="54"
        android:translateY="54"
        android:scaleX="2.9"
        android:scaleY="2.9"
        android:pivotX="0"
        android:pivotY="0">
        <group android:translateX="-12" android:translateY="-12">
            <path android:pathData="M13.6,2.2 L4.2,13.9 L10.8,13.9 L9.4,21.8 L19.8,9.7 L13.2,9.7 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="4.2"
                        android:startY="2.2"
                        android:endX="19.8"
                        android:endY="21.8">
                        <item android:offset="0.0" android:color="#FF4FD1C2" />
                        <item android:offset="0.5" android:color="#FF1FB8A6" />
                        <item android:offset="0.78" android:color="#FF0D9488" />
                        <item android:offset="1.0" android:color="#FFE8950A" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
</vector>
