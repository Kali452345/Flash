<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Lightweight cold-start theme. Actual colors are driven by the Compose
         Material 3 theme at runtime; this only controls the initial window frame. -->
    <style name="Theme.MediaDownloader" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
