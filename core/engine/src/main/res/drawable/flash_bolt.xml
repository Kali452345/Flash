      Flash mark (lightning bolt), teal -> spark-amber gradient.
      Bundled with core:engine so consumers can reference @drawable/flash_bolt.
      Master: logo-claude/svg/flash-icon-pulse.svg (bolt geometry).
    -->
    <path android:pathData="M13.6,2.2 L4.2,13.9 L10.8,13.9 L9.4,21.8 L19.8,9.7 L13.2,9.7 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4.2"
                android:startY="2.2"
                android:endX="19.8"
                android:endY="21.8">
                <item android:offset="0.0" android:color="#FF4FD1C2" />
                <item android:offset="0.5" android:color="#FF1FB8A6" />
                <item android:offset="0.78" android:color="#FF0D9488" />
                <item android:offset="1.0" android:color="#FFE8950A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
